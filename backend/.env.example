# Required: GraphHopper routing provider
GRAPHHOPPER_API_KEY=replace_with_your_graphhopper_api_key

# PostgreSQL: use DATABASE_URL OR the individual POSTGRES_* values below.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/navigo_db

# Alternative individual database settings (used when DATABASE_URL is unset)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DATABASE=navigo_db

# Authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cache durations
SEARCH_CACHE_TTL_SECONDS=300
ROUTE_CACHE_TTL_SECONDS=120

# Set development while running locally.
ENVIRONMENT=development
